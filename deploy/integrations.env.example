# Documentation template ONLY: not loaded by Compose.
# Use a private override that mounts these secrets only into backend.
GEMINI_API_KEY_FILE=<SET_GEMINI_API_KEY_FILE>
GEMINI_MODEL=<SET_GEMINI_MODEL>
AI_DAILY_LIMIT=<SET_AI_DAILY_LIMIT>
AI_GLOBAL_CONCURRENCY=<SET_AI_GLOBAL_CONCURRENCY>
AI_RETENTION_DAYS=<SET_AI_RETENTION_DAYS>
MOODLE_BASE_URL=<SET_MOODLE_BASE_URL>
MOODLE_ENCRYPTION_KEY_FILE=<SET_MOODLE_ENCRYPTION_KEY_FILE>
MOODLE_SYNC_ENABLED=<SET_MOODLE_SYNC_ENABLED>
MOODLE_SYNC_INTERVAL_MINUTES=<SET_MOODLE_SYNC_INTERVAL_MINUTES>
# Moodle key: stable random 32 bytes encoded as 64 hexadecimal characters.
# Never enable or add paid credentials during preparation/smoke testing.
PUSH_ENABLED=<SET_PUSH_ENABLED>
PUSH_ENCRYPTION_KEY_FILE=<SET_PUSH_ENCRYPTION_KEY_FILE>
VAPID_PUBLIC_KEY_FILE=<SET_VAPID_PUBLIC_KEY_FILE>
VAPID_PRIVATE_KEY_FILE=<SET_VAPID_PRIVATE_KEY_FILE>
# Configure an authorized contact before enabling Web Push.
VAPID_SUBJECT=<SET_VAPID_SUBJECT>
