# Copy to deploy/.env. No secrets belong in this file.
PUBLIC_ORIGIN=<SET_PUBLIC_ORIGIN>
HTTPS_PORT=<SET_HTTPS_PORT>
HTTPS_BIND_ADDRESS=<SET_HTTPS_BIND_ADDRESS>
# Secret files under deploy/secrets are generated locally, never committed.
# Optional integrations stay OFF until approved institution credentials exist.
# Set GEMINI_API_KEY_FILE / MOODLE_ENCRYPTION_KEY_FILE via a private Compose
# override and explicit secret mounts; never use VITE_* for private values.
